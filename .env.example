# ─────────────────────────────────────────────────────────────────────────────
# JARVIS-X server configuration. Copy to .env and fill in what you use.
# Everything is optional except PUBLIC_URL (and secrets in production).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080
PUBLIC_URL=https://jarvis.example.com     # exact public origin (used for cookies, redirects, reset links)
TRUST_PROXY=true                          # true behind nginx/Caddy/Cloudflare so client IPs are correct
DATA_DIR=./data                           # SQLite database + generated secrets live here — back it up

# Secrets (generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=
VAULT_SECRET=                             # encrypts synced user data at rest — never change after launch
SESSION_DAYS=30

# ── AI (server-side keys; browsers never see them) ──────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# or an OpenAI-compatible provider:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# or Google Gemini (free key from aistudio.google.com/apikey):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_PROVIDER=                              # anthropic | openai | gemini (auto-detected from keys)
AI_MAX_TOKENS=2048
AI_WEB=on                                 # live web for the assistant: on (Anthropic web search/fetch) | basic (free search) | off

# ── Fair use (everything is free; these only protect your server) ─────────
AI_DAILY_LIMIT=0                          # AI requests per person per day; 0 = unlimited
MAX_DEVICES=20                            # signed-in devices per account

# ── Plugins & music (all optional) ───────────────────────────────────────────
REPLICATE_API_TOKEN=                      # Video Studio + FLUX images via Replicate (people can also use their own token)
YOUTUBE_API_KEY=                          # optional: official YouTube search (without it, public Piped/Invidious mirrors are used)
YOUTUBE_MIRRORS=                          # optional: comma list like piped:https://pipedapi.example,invidious:https://inv.example

# ── Email (password reset). Without a key, reset links are printed to the log.
RESEND_API_KEY=
MAIL_FROM=JARVIS-X <no-reply@jarvis.example.com>

# ── Code runner: off | docker (recommended) | local (development only!)
CODE_RUNNER=off
CODE_TIMEOUT_MS=8000

# ── Market data (optional; Yahoo Finance delayed quotes are used otherwise)
FINNHUB_API_KEY=
